# Server Port
PORT=5000

# MongoDB Connection String (local or MongoDB Atlas)
MONGO_URI=mongodb://localhost:27017/resumeBuilder

# Google Gemini AI API Key — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Secret used to sign login sessions (JWT). Use a long random string in production,
# e.g. generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Comma-separated list of extra allowed frontend origins in production
# (localhost is always allowed automatically for local development)
CLIENT_ORIGIN=https://your-app.vercel.app

# ── SendGrid (email OTP verification) ────────────────────────────────────────
# API key from https://app.sendgrid.com/settings/api_keys (needs "Mail Send" permission)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
# MUST be an address you verified in SendGrid under Settings > Sender Authentication.
# SendGrid rejects sends from unverified addresses with a 403.
SENDGRID_FROM_EMAIL=no-reply@yourdomain.com
# Display name shown in the recipient's inbox
SENDGRID_FROM_NAME=ResumeAI
